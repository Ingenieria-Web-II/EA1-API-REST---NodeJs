{
  "info": {
    "name": "Peliculas API - NodeJs",
    "_postman_id": "a1b2c3d4-e5f6-7890-1234-56789abcdef0",
    "description": "Colección CRUD completa para probar la API REST de Películas con NodeJs, Express y MongoDB Atlas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Generos",
      "item": [
        {
          "name": "Crear Género (POST)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Acción\",\n  \"descripcion\": \"Películas de acción\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/generos", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "generos"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["let data = pm.response.json();", "if (data._id) pm.collectionVariables.set('ID_GENERO', data._id);"] }
          }]
        },
        {
          "name": "Listar Géneros (GET)",
          "request": { "method": "GET", "url": "http://localhost:5000/api/generos" }
        },
        {
          "name": "Obtener Género por ID (GET)",
          "request": { "method": "GET", "url": "http://localhost:5000/api/generos/{{ID_GENERO}}" }
        },
        {
          "name": "Actualizar Género (PUT)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"descripcion\": \"Películas de acción actualizadas\"\n}" },
            "url": "http://localhost:5000/api/generos/{{ID_GENERO}}"
          }
        },
        {
          "name": "Eliminar/Desactivar Género (DELETE)",
          "request": { "method": "DELETE", "url": "http://localhost:5000/api/generos/{{ID_GENERO}}" }
        }
      ]
    },
